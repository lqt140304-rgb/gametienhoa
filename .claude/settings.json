{
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/session_brief.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
