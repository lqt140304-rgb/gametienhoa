  m_Name: Core_core.mang_tham_thau
  m_EditorClassIdentifier: Evolve::Evolve.Traits.CoreSO
  Id: core.mang_tham_thau
  DisplayName: "M\xE0ng Th\u1EA9m Th\u1EA5u"
  Summary: "\u0110\u1EE9ng y\xEAn trong n\u01B0\u1EDBc n\xF4ng ho\u1EB7c hang tr\xFA th\xEC h\xFAt d\u01B0\u1EE1ng ch\u1EA5t."
  Detail: "\u0110\u1EE9ng y\xEAn (d\u01B0\u1EDBi 0,3 m/s) trong n\u01B0\u1EDBc n\xF4ng ho\u1EB7c trong hang tr\xFA c\xF3 r\xEAu \u1EA9m th\xEC h\xFAt d\u01B0\u1EE1ng ch\u1EA5t d\u1EA7n (t\u1EA1m 1,5% \u0111\u1ED9 no m\u1ED7i gi\xE2y), ng\u1EEBng hao \u0111\u1ED9 no. T\u1ED1i \u0111a l\u1EA5p \u0111\u1EA7y 60% thanh no; b\u1ECB \u0111\xE1nh th\xEC ng\u1EAFt 3 gi\xE2y; kh\xF4ng ho\u1EA1t \u0111\u1ED9ng khi b\u01A1i n\u01B0\u1EDBc s\xE2u."
  OrbColor: {r: 0.95, g: 0.42749998, b: 0.42749998, a: 1}
  Options:
  - FlawIds:
    - flaw.run_ray
  - FlawIds:
